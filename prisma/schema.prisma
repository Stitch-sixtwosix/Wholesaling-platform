// Virtual Wholesaling Platform — data model
// SQLite-friendly: list-type fields are stored as comma-separated strings or JSON.
//
// Multi-tenant: every top-level record carries an `orgId`. All reads/writes are
// scoped to the signed-in user's organization. Child records (Comp, Activity,
// CampaignMember) inherit scope through their parent relations.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id           String   @id @default(cuid())
  name         String
  apolloApiKey String? // per-org Apollo.io API key for buyer discovery/enrichment
  resendApiKey String? // per-org Resend API key for sending contracts/emails
  fromEmail    String? // verified sender address for outbound email
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users       User[]
  invitations Invitation[]
}

model Invitation {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      String       @default("acquisitions") // acquisitions | dispositions | manager | admin
  token     String       @unique @default(cuid())
  accepted  Boolean      @default(false)
  invitedBy String?
  createdAt DateTime     @default(now())

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// People & access
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  email        String       @unique
  role         String       @default("acquisitions") // admin | acquisitions | dispositions | manager
  passwordHash String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  leads Lead[]
  deals Deal[]
  tasks Task[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Properties
// ---------------------------------------------------------------------------

model Property {
  id           String  @id @default(cuid())
  orgId        String
  address      String
  city         String
  state        String
  zip          String
  county       String?
  propertyType String  @default("single_family") // single_family | multi_family | condo | townhouse | land | mobile | commercial
  beds         Int?
  baths        Float?
  sqft         Int?
  lotSizeSqft  Int?
  yearBuilt    Int?
  condition    String  @default("unknown") // excellent | good | fair | poor | distressed | unknown
  occupancy    String  @default("unknown") // owner | tenant | vacant | unknown

  // Valuation
  arv            Float? // After Repair Value
  repairEstimate Float?
  estimatedValue Float? // current as-is value / Zestimate-style
  taxAssessed    Float?
  annualTaxes    Float?

  notes      String?
  photosJson String? // JSON array of photo URLs
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads Lead[]
  deals Deal[]
  comps Comp[]

  @@index([orgId])
}

// Comparable sales used to estimate ARV
model Comp {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  address    String
  salePrice  Float
  saleDate   DateTime?
  beds       Int?
  baths      Float?
  sqft       Int?
  distanceMi Float?
  notes      String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Deal Finder — on-market listings watched for stale/motivated opportunities
// ---------------------------------------------------------------------------

model Listing {
  id           String   @id @default(cuid())
  orgId        String
  address      String
  city         String
  state        String
  zip          String
  source       String   @default("manual") // manual | zillow | redfin | mls | csv | other
  url          String? // link to the original listing
  listPrice    Float
  listDate     DateTime // when it hit the market (drives days-on-market)
  beds         Int?
  baths        Float?
  sqft         Int?
  propertyType String   @default("single_family")

  // Optional valuation inputs for a sharper suggested offer
  arv            Float?
  repairEstimate Float?

  status    String  @default("watching") // watching | converted | dismissed
  leadId    String? // set when converted into a lead/deal
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Acquisitions CRM — seller leads
// ---------------------------------------------------------------------------

model Lead {
  id        String  @id @default(cuid())
  orgId     String
  firstName String
  lastName  String?
  email     String?
  phone     String?
  altPhone  String?

  // Lead lifecycle
  status      String  @default("new") // new | contacted | qualified | appointment | offer_made | under_contract | dead | nurture
  source      String  @default("other") // ppc | seo | direct_mail | cold_call | sms | driving_for_dollars | referral | list | bandit_sign | other
  motivation  String? // foreclosure | divorce | inherited | tired_landlord | relocation | financial | repairs | vacant | other
  temperature String  @default("warm") // hot | warm | cold
  askingPrice Float?
  notes       String?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastContact DateTime?

  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  campaignMembers CampaignMember[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Deals — the pipeline (links leads + properties + buyers)
// ---------------------------------------------------------------------------

model Deal {
  id     String @id @default(cuid())
  orgId  String
  title  String
  stage  String @default("lead") // lead | contacted | appointment | offer | under_contract | assigned | closed | dead
  status String @default("active") // active | won | lost

  // Economics
  arv            Float?
  repairEstimate Float?
  contractPrice  Float? // what we agree to buy from seller
  resalePrice    Float? // what buyer pays (assignment) / sale price
  assignmentFee  Float? // our profit
  closingCosts   Float?

  expectedCloseDate DateTime?
  closedDate        DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  tasks      Task[]
  contracts  Contract[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Dispositions CRM — cash buyers
// ---------------------------------------------------------------------------

model Buyer {
  id        String  @id @default(cuid())
  orgId     String
  firstName String
  lastName  String?
  company   String?
  email     String?
  phone     String?

  buyerType    String  @default("flipper") // flipper | landlord | wholesaler | owner_occupant | hedge_fund | other
  status       String  @default("active") // active | inactive | vip
  proofOfFunds Boolean @default(false)
  cashBuyer    Boolean @default(true)

  // Buy box (criteria)
  markets       String? // comma separated cities/zips/counties
  propertyTypes String? // comma separated
  minPrice      Float?
  maxPrice      Float?
  minBeds       Int?
  maxRehab      Float?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals           Deal[]
  activities      Activity[]
  campaignMembers CampaignMember[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Contracts
// ---------------------------------------------------------------------------

model Contract {
  id     String @id @default(cuid())
  orgId  String
  type   String @default("purchase") // purchase | assignment | jv | option
  title  String
  status String @default("draft") // draft | sent | signed | executed | cancelled

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  buyerName       String?
  sellerName      String?
  propertyAddress String?
  purchasePrice   Float?
  assignmentFee   Float?
  earnestMoney    Float?
  closingDate     DateTime?
  inspectionDays  Int?

  body       String? // generated contract text
  sentDate   DateTime?
  signedDate DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Marketing
// ---------------------------------------------------------------------------

model Campaign {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  channel  String  @default("sms") // sms | email | direct_mail | cold_call | rvm | ppc
  status   String  @default("draft") // draft | active | paused | completed
  audience String? // description of the list targeted

  // Performance
  sent      Int   @default(0)
  delivered Int   @default(0)
  responses Int   @default(0)
  leads     Int   @default(0)
  cost      Float @default(0)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members CampaignMember[]

  @@index([orgId])
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  status    String   @default("queued") // queued | sent | delivered | responded | bounced | opted_out
  createdAt DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  channel   String   @default("sms") // sms | email | direct_mail | contract
  subject   String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Tasks & activity log
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  description String?
  status      String    @default("open") // open | in_progress | done
  priority    String    @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  completedAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String   @default("note") // note | call | sms | email | meeting | status_change | offer | system
  body      String
  createdAt DateTime @default(now())

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}
