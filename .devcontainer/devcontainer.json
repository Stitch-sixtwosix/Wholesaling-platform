{
  "name": "WholesaleOS",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "postCreateCommand": "npm install && cp -n .env.example .env || true && npm run setup",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "WholesaleOS",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma", "dbaeumer.vscode-eslint"]
    }
  }
}
